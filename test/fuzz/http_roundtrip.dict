# HTTP tokens that steer the round-trip fuzzer toward parser and serializer corners
"GET / HTTP/1.1\x0d\x0a"
"POST / HTTP/1.1\x0d\x0a"
"HTTP/1.1 200 OK\x0d\x0a"
"HTTP/1.1 404 Not Found\x0d\x0a"
"HTTP/1.0 500 Internal Server Error\x0d\x0a"
"Host: example.com\x0d\x0a"
"Content-Length: "
"Transfer-Encoding: chunked\x0d\x0a"
"Transfer-Encoding: identity\x0d\x0a"
"Connection: close\x0d\x0a"
"Connection: keep-alive\x0d\x0a"
"Expect: 100-continue\x0d\x0a"
"Upgrade: websocket\x0d\x0a"
"Te: trailers\x0d\x0a"
"Content-Encoding: gzip\x0d\x0a"
"Accept: */*;q=0.5\x0d\x0a"
"Cookie: a=1; b=2\x0d\x0a"
"If-None-Match: \"etag\"\x0d\x0a"
"X-Custom: v\x0d\x0a"
"X-Multi: 1\x0d\x0aX-Multi: 2\x0d\x0a"
"Content-Range: bytes 0-4/10\x0d\x0a"
"Range: bytes=0-\x0d\x0a"
"4;ext=val\x0d\x0a"
"0\x0d\x0a\x0d\x0a"
"5\x0d\x0ahello\x0d\x0a"
";q=0.9"
";name=value"
"\x0d\x0a\x0d\x0a"
